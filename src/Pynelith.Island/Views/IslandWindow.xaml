<Window x:Class="Pynelith.Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith Island"
        Width="240" Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9EFFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7BE0FF"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="13" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 玻璃效果由渲染模块安装在 IslandRoot 上（注入底层玻璃层 + ShaderEffect），
         这里只需保证根容器透明、可命中测试；窗口本身是分层窗口，圆角外真正透出桌面。 -->
    <Grid x:Name="IslandRoot"
          ClipToBounds="True"
          Background="Transparent"
          MouseLeftButtonDown="OnIslandMouseLeftButtonDown"
          MouseMove="OnIslandMouseMove"
          MouseLeftButtonUp="OnIslandMouseLeftButtonUp">

        <!-- 内容整体按 GlobalScale 缩放，岛尺寸同步放大，排版比例保持一致 -->
        <Grid x:Name="ContentHost">
            <!-- 收起态：胶囊 -->
            <Grid x:Name="CollapsedView">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CollapsedTime"
                               Margin="9,0,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="11" Margin="10,0"
                            Background="{StaticResource DividerBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="CollapsedHint"
                               Text="待机"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 展开态：通知 + 正在播放 + 歌词 -->
            <Grid x:Name="ExpandedView" Visibility="Collapsed">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CollapseButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⌃"
                                    ToolTip="收起"
                                    Click="OnCollapseClick"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pynelith"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="ExpandedSubtitle"
                                       FontSize="10.5"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <ItemsControl x:Name="NotificationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            CornerRadius="11"
                                            Padding="11,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="5" Height="5"
                                                     Fill="{Binding Accent}"
                                                     VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AppName}"
                                                           FontSize="10"
                                                           Margin="0,1,0,0"
                                                           Foreground="{StaticResource TextTertiary}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="NowPlaying"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="11"
                                Padding="11,9"
                                Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="9">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#B44CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Artist}"
                                               FontSize="10.5"
                                               Margin="0,1,0,0"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="♫"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="LyricsText"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="FooterText"
                               Grid.Row="2"
                               Text="拖动移动 · 点击切换 · ⌃ 收起"
                               FontSize="10"
                               Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
