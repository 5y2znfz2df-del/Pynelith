<Window x:Class="Pynelith.Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith Island"
        Width="400" Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9EFFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7BE0FF"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="13" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="IslandMenu">
            <MenuItem Header="设置" Click="OnOpenSettings"/>
            <MenuItem Header="退出 Pynelith" Click="OnExit"/>
        </ContextMenu>
    </Window.Resources>

    <!-- 窗口尺寸固定为媒体态尺寸（分层窗口每帧改尺寸会导致 DWM 重组卡顿）；
         真正的"岛"是 CapsuleHost，弹簧动画只改它的大小，玻璃效果装在它上面。
         注意：IslandRoot 不能设 Background（透明背景也可命中），否则整块隐形矩形
         会吞掉其下方所有窗口的鼠标点击；命中测试只保留在胶囊本体。 -->
    <Grid x:Name="IslandRoot" ClipToBounds="False">

        <Grid x:Name="CapsuleHost"
              Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="128" Height="28"
              ContextMenu="{StaticResource IslandMenu}"
              MouseLeftButtonDown="OnIslandMouseLeftButtonDown"
              MouseMove="OnIslandMouseMove"
              MouseLeftButtonUp="OnIslandMouseLeftButtonUp">

            <!-- 设计尺寸 = 配置尺寸（缩放前），LayoutTransform 统一放大 -->
            <Grid x:Name="ContentHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- 空闲态：无媒体播放时的时间胶囊 -->
                <Grid x:Name="IdleView" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleTime"
                                   Margin="9,0,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="11" Margin="10,0"
                                Background="{StaticResource DividerBrush}"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleHint"
                                   Text="待机"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 媒体态：封面 + 曲目/歌词 + SMTC 播放控制（直显，无展开交互） -->
                <Grid x:Name="MediaView" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MediaScale" ScaleX="0.94" ScaleY="0.94"/>
                    </Grid.RenderTransform>
                    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 专辑封面 -->
                        <Border Width="52" Height="52" CornerRadius="13" ClipToBounds="True" Background="#14FFFFFF">
                            <Grid>
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                                <Border x:Name="CoverFallback">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#B44CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="♫"
                                               FontSize="18"
                                               Foreground="#E6FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 曲目信息 + 歌词行（交叉淡入滚动） -->
                        <Grid Grid.Column="1" Margin="12,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MediaTitle"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="220"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="MediaArtist"
                                           FontSize="10.5"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid x:Name="LyricHost"
                                  Grid.Row="1"
                                  Height="21"
                                  Margin="0,3,0,0"
                                  ClipToBounds="True">
                                <TextBlock x:Name="LyricA"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Opacity="0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LyricATrans"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="LyricB"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Opacity="0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LyricBTrans"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- SMTC 播放控制 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PrevButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⏮"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="上一首"
                                    Click="OnSkipPrevious"/>
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource IconButton}"
                                    Content="▶"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="播放 / 暂停"
                                    Margin="6,0"
                                    Click="OnTogglePlay"/>
                            <Button x:Name="NextButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⏭"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="下一首"
                                    Click="OnSkipNext"/>
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⚙"
                                    ToolTip="设置"
                                    Margin="10,0,0,0"
                                    Click="OnOpenSettings"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
