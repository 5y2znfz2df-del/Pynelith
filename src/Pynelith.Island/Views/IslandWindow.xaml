<Window x:Class="Pynelith.Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith Island"
        Width="260" Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="pack://application:,,,/Pynelith.Island;component/Fonts/#PingFang SC">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9EFFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF"/>
        <!-- 图标前景：跟随系统深浅反相（浅色系统下变成深色） -->
        <SolidColorBrush x:Key="IconPrimary" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="IconSecondary" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7BE0FF"/>

        <Style x:Key="CompactIconButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Music 风格细滑杆：3px 轨道 + 白色圆形滑块。
             轨道视觉只有 3px，但 Slider 自身留出 14px 高的命中区，方便鼠标抓取。 -->
        <Style x:Key="AppleSlider" TargetType="Slider">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Height="10">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource IconPrimary}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="#3DFFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="9" Height="9" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="9" Height="9" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 时长未知（直播流 / 播放器不回报时长）时整条进度不可拖，视觉上压暗 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 展开面板的次级按钮（随机 / 循环）：22px，矢量图标随 Foreground 变色 -->
        <Style x:Key="DetailMiniButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 展开面板的上一首 / 下一首：32px，SF Symbols 风格的双实心圆角三角 -->
        <Style x:Key="DetailIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource IconPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 展开面板的主播放键：46×34 的圆角胶囊，内部是圆角播放/暂停图标。
             参考 iOS 灵动岛展开态的玻璃按钮：始终有一层很淡的圆角底色，悬停时提亮。 -->
        <Style x:Key="DetailPlayStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#1FFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具面板的胶囊按钮（开始 / 暂停 / 重置）：浅玻璃底，悬停提亮 -->
        <Style x:Key="ToolsButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#1FFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具面板的文字按钮（清空）：无底色，只有文字色变化 -->
        <Style x:Key="ToolsLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 窗口固定为最大形态尺寸（展开态）；真正的"岛"是 CapsuleHost，弹簧只改它的宽高。
         内容用「固定尺寸图层 + 交叉淡入」，动画帧内不做任何布局重算，因此不会有抖动。
         注意：IslandRoot 不能设 Background，否则整块隐形矩形会吞掉下方窗口的鼠标点击。 -->
    <Grid x:Name="IslandRoot" ClipToBounds="False">

        <Grid x:Name="CapsuleHost"
              Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="124" Height="24"
              MouseEnter="OnIslandMouseEnter"
              MouseLeave="OnIslandMouseLeave"
              MouseLeftButtonDown="OnIslandMouseLeftButtonDown"
              MouseMove="OnIslandMouseMove"
              MouseLeftButtonUp="OnIslandMouseLeftButtonUp">

            <!-- 入场位移：开机 / 解锁时胶囊从屏幕顶端之上滑入（先快后慢）。
                 只做视觉位移，不改窗口位置，因此不会与停靠守护冲突。 -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IntroTranslate"/>
            </Grid.RenderTransform>

            <!-- 右键菜单内联定义：避免共享资源实例导致弹不出 -->
            <Grid.ContextMenu>
                <ContextMenu Opened="OnIslandMenuOpened">
                    <MenuItem Header="歌词提前 200ms" Click="OnLyricEarlier"/>
                    <MenuItem Header="歌词延后 200ms" Click="OnLyricLater"/>
                    <MenuItem Header="歌词偏移归零" Click="OnLyricOffsetReset"/>
                    <Separator/>
                    <MenuItem Header="工具面板" Click="OnOpenToolsPanel"/>
                    <MenuItem Header="设置" Click="OnOpenSettings"/>
                    <MenuItem Header="退出 Pynelith" Click="OnExit"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 主题底色：纯黑 / 磨砂模式的不透明底，液态玻璃模式下保持透明由玻璃层负责 -->
            <Border x:Name="ThemeBackdrop"
                    Background="Transparent"
                    BorderThickness="0"
                    IsHitTestVisible="False"/>

            <!-- 表面层次：顶部柔光 + 底部内阴影，营造半透明磨砂玻璃的纵向深度。
                 MaxHeight 让光带在展开态保持"贴边窄带"（约 20px），
                 不会因面板变高而摊成一大片发灰的雾面。 -->
            <Grid x:Name="CapsuleSheen" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.75">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.34*" MaxHeight="22"/>
                    <RowDefinition Height="0.36*"/>
                    <RowDefinition Height="0.30*" MaxHeight="24"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#17FFFFFF" Offset="0"/>
                            <GradientStop Color="#08FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Grid.Row="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#2E000000" Offset="0.65"/>
                            <GradientStop Color="#38000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 高光：窄而柔的弧形反光，沿圆角轮廓走；不用直线，也不做整圈硬白边 -->
            <Grid x:Name="CapsuleHighlight" IsHitTestVisible="False" ClipToBounds="True">
                <!-- 极淡的左上折射光，不形成大面积泛白 -->
                <Ellipse Width="170" Height="84"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-42,-42,0,0" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                            <GradientStop Color="#07FFFFFF" Offset="0.6"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 弧形光晕：窄而淡、带模糊，只在顶部一小段可见 -->
                <Path x:Name="TopArcPath"
                      StrokeThickness="1.8"
                      StrokeLineJoin="Round"
                      Opacity="0.30"
                      IsHitTestVisible="False">
                    <Path.Effect>
                        <BlurEffect Radius="3.2" KernelType="Gaussian"/>
                    </Path.Effect>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="0.14"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.32"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- 细弧线：0.6px、低透明度、轻微模糊，只给左上角一条很窄的亮边 -->
                <Path x:Name="HighlightPath"
                      StrokeThickness="0.6"
                      StrokeLineJoin="Round"
                      Opacity="0.34"
                      IsHitTestVisible="False">
                    <Path.Effect>
                        <BlurEffect Radius="0.9" KernelType="Gaussian"/>
                    </Path.Effect>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6AFFFFFF" Offset="0"/>
                            <GradientStop Color="#16FFFFFF" Offset="0.18"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.86"/>
                            <GradientStop Color="#12FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Grid>

            <!-- 设计尺寸 = 胶囊尺寸（缩放前），ContentScale 统一放大 -->
            <!-- 用 Canvas 承载 ContentHost：Canvas 不约束、不裁剪子元素。
                 否则 GlobalScale<1 时 ContentHost 的设计宽度大于胶囊，会被父级按槽位裁掉，
                 最右侧的「下一首」按钮就会消失。 -->
            <Canvas x:Name="ContentCanvas" ClipToBounds="False">
            <!-- ContentHost 以「未缩放设计尺寸」布局，再由 ContentScale 放大/缩小到胶囊实际尺寸。
                 必须左上对齐：RenderTransform 以左上角为原点，居中会让 GlobalScale≠1 时整体
                 向左/右偏移（消息文字顶到圆角外就是这么来的）。 -->
            <Grid x:Name="ContentHost"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- 空闲态：无媒体播放时的时间胶囊 -->
                <Grid x:Name="IdleView" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="IdleTime"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="IdleClockDivider"
                                Width="1" Height="9" Margin="8,0"
                                Background="{StaticResource DividerBrush}"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleHint"
                                   Text="待机"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="IdleMetricsDivider"
                                Width="1" Height="9" Margin="8,0"
                                Background="{StaticResource DividerBrush}"
                                VerticalAlignment="Center"/>
                        <!-- 固定宽度 + 等宽字体：数值跳动不会改变胶囊宽度 -->
                        <TextBlock x:Name="IdleMetrics"
                                   Width="108"
                                   FontSize="9"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>

                        <!-- Siri 光点：组件启用时出现在胶囊右端，作为极简的状态标识。
                             点击它唤起透镜；点击胶囊其余区域仍是原有的大时钟 / 详情面板。 -->
                        <Grid x:Name="SiriDot"
                              Width="10" Height="10" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#B8CCE8FF" Offset="0.42"/>
                                        <GradientStop Color="#0078B4FF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="4.5" Height="4.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#E6D6ECFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 空闲展开态：点击待机胶囊后显示的大时钟 + 日期 + 资源占用 -->
                <Grid x:Name="IdleDetailLayer" Width="224" Height="60" Opacity="0"
                      VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="IdleDetailTime"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="IdleDetailDivider"
                                Width="1" Height="28" Margin="12,0"
                                Background="{StaticResource DividerBrush}"
                                VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="IdleDetailDate"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="IdleDetailMetrics"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="IdleDetailStatus"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{StaticResource TextTertiary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 紧凑态：不设固定宽高，铺满胶囊（20px 封面 + 单行文字 + 三个控制键）。
                     胶囊按配置在 120~240 之间变化，固定 180 会在窄胶囊里被裁掉两端。 -->
                <Grid x:Name="CompactLayer" Opacity="0">
                    <Border x:Name="CompactCover" Width="20" Height="20"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                            Background="#14FFFFFF">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,20,20" RadiusX="6.5" RadiusY="6.5"/>
                        </Border.Clip>
                        <Grid>
                            <Image x:Name="CompactCoverImage" Stretch="UniformToFill"/>
                            <Border x:Name="CompactCoverFallback">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#B44CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="♫" FontSize="9" Foreground="{StaticResource IconPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="CompactLyricHost" Height="18" Margin="40,0,80,0"
                          VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock x:Name="CompactLyricA" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactLyricATrans"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="CompactLyricB" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactLyricBTrans"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- 展开态：仿 iOS 灵动岛展开态的播放面板（320×140）。
                     高度落在规范 80~140 的上限，圆角 24。 -->
                <Grid x:Name="DetailLayer" Width="320" Height="140" Opacity="0"
                      VerticalAlignment="Center">
                    <Grid Margin="12,13,12,8" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 封面 + 标题 / 歌手 / 当前歌词 + 右侧播放律动条 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DetailCover" Width="50" Height="50"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#14FFFFFF">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,50,50" RadiusX="13" RadiusY="13"/>
                                </Border.Clip>
                                <Grid>
                                    <Image x:Name="DetailCoverImage" Stretch="UniformToFill"/>
                                    <Border x:Name="DetailCoverFallback">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4C7DFF" Offset="0"/>
                                                <GradientStop Color="#B44CFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="♫" FontSize="17" Foreground="{StaticResource IconPrimary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,6,4,0">
                                <TextBlock x:Name="TrackLabel"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistLabel"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0"/>
                                <Grid x:Name="DetailLyricHost" Height="10" ClipToBounds="True"
                                      Margin="0,1,0,0">
                                    <TextBlock x:Name="DetailLyricA" FontSize="8.5"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="DetailLyricATrans"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="DetailLyricB" FontSize="8.5"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="DetailLyricBTrans"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- 播放律动：播放时亮起，暂停时压暗（纯装饰，不参与点击） -->
                            <Canvas x:Name="DetailWaveform" Grid.Column="2" Width="18" Height="12"
                                    VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
                                <Border Canvas.Left="0" Canvas.Top="2.5" Width="2.5" Height="7"
                                        CornerRadius="1.25" Background="{StaticResource IconPrimary}"/>
                                <Border Canvas.Left="5" Canvas.Top="0" Width="2.5" Height="12"
                                        CornerRadius="1.25" Background="{StaticResource IconSecondary}"/>
                                <Border Canvas.Left="10" Canvas.Top="3.5" Width="2.5" Height="5"
                                        CornerRadius="1.25" Background="{StaticResource IconPrimary}"/>
                                <Border Canvas.Left="15" Canvas.Top="1.5" Width="2.5" Height="9"
                                        CornerRadius="1.25" Background="{StaticResource IconSecondary}"/>
                            </Canvas>
                        </Grid>

                        <!-- 底部区域：按灵动岛布局铺满整行。
                             左侧时间落在封面下方，进度条从封面右缘开始，右侧为剩余时间。 -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ElapsedText" Text="0:00"
                                       FontSize="8.5" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>

                            <Slider x:Name="SeekSlider" Grid.Column="1"
                                    Style="{StaticResource AppleSlider}"
                                    Minimum="0" Maximum="1" Value="0"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    ToolTip="拖动调整播放进度"
                                    Margin="2,0,2,0"/>

                            <TextBlock x:Name="RemainingText" Grid.Column="2" Text="–:–"
                                       FontSize="8.5" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 播放控制：随机 / 上一首 / 播放暂停 / 下一首 / 循环。
                             全部用矢量 Path 绘制：双实心三角、圆角暂停条、交叉箭头，
                             对应 SF Symbols 的 backward.fill / play.fill / shuffle / repeat。 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,3,0,0">
                            <Button x:Name="ShuffleButton" Style="{StaticResource DetailMiniButton}"
                                    ToolTip="随机播放" Click="OnToggleShuffle">
                                <Canvas Width="16" Height="12">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M 1,3 H 4.2 L 11.8,9 H 15.6"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M 1,9 H 4.2 L 11.8,3 H 15.6"/>
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M 13.1,1.3 L 15.7,3 L 13.1,4.7 Z"/>
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M 13.1,7.3 L 15.7,9 L 13.1,10.7 Z"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="DetailPrevButton" Style="{StaticResource DetailIconButton}"
                                    Margin="12,0,0,0" ToolTip="上一首" Click="OnSkipPrevious">
                                <Canvas Width="22" Height="18">
                                    <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="3.5"
                                          StrokeLineJoin="Round" Data="M 9.4,2.2 L 2.1,9 L 9.4,15.8 Z"/>
                                    <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="3.5"
                                          StrokeLineJoin="Round" Data="M 19.6,2.2 L 13,9 L 19.6,15.8 Z"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="DetailPlayButton" Style="{StaticResource DetailPlayStyle}"
                                    Margin="10,0" ToolTip="播放 / 暂停" Click="OnTogglePlay">
                                <!-- 图标画布比图形本身留 1~2px 余量，避免任何 DPI 下被布局边界裁切 -->
                                <Grid Width="22" Height="24">
                                    <Path x:Name="DetailPlayGlyph" Fill="White" Stroke="White"
                                          StrokeThickness="7" StrokeLineJoin="Round"
                                          Data="M 3.5,3.5 L 17,11 L 3.5,18.5 Z"/>
                                    <Grid x:Name="DetailPauseGlyph" Visibility="Collapsed">
                                        <Rectangle Width="6" Height="20" RadiusX="2.5"
                                                   Fill="White" HorizontalAlignment="Left" Margin="2.5,0,0,0"/>
                                        <Rectangle Width="6" Height="20" RadiusX="2.5"
                                                   Fill="White" HorizontalAlignment="Right" Margin="0,0,2.5,0"/>
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button x:Name="DetailNextButton" Style="{StaticResource DetailIconButton}"
                                    Margin="0,0,12,0" ToolTip="下一首" Click="OnSkipNext">
                                <Canvas Width="22" Height="18">
                                    <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="3.5"
                                          StrokeLineJoin="Round" Data="M 2.4,2.2 L 9,9 L 2.4,15.8 Z"/>
                                    <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="3.5"
                                          StrokeLineJoin="Round" Data="M 12.6,2.2 L 19.9,9 L 12.6,15.8 Z"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="RepeatButton" Style="{StaticResource DetailMiniButton}"
                                    ToolTip="循环模式" Click="OnCycleRepeat">
                                <Grid Width="16" Height="12">
                                    <Canvas>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M 3,7.4 V 5 A 2.5,2.5 0 0 1 5.5,2.5 H 12.4"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M 13,4.6 V 7 A 2.5,2.5 0 0 1 10.5,9.5 H 3.6"/>
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M 11.4,1 L 14.2,2.5 L 11.4,4 Z"/>
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M 4.6,8 L 1.8,9.5 L 4.6,11 Z"/>
                                    </Canvas>
                                    <!-- 单曲循环时在环内显示 1（对应 SF Symbols 的 repeat.1） -->
                                    <TextBlock x:Name="RepeatOneBadge" Text="1"
                                               Visibility="Collapsed"
                                               FontSize="6.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0.5,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- 系统音量：低音量的喇叭图标 + 细滑杆，作为紧凑面板的底部一栏 -->
                        <Grid Grid.Row="3" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="VolumeGlyph" Width="16" Height="12" VerticalAlignment="Center">
                                <Canvas x:Name="VolumeSpeaker">
                                    <Path Fill="#A6FFFFFF" Data="M 1,4 H 4 L 7.5,1 V 11 L 4,8 H 1 Z"/>
                                    <Path Stroke="#A6FFFFFF" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 9.6,4 A 3.2,3.2 0 0 1 9.6,8"/>
                                    <Path Stroke="#A6FFFFFF" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 11.9,2.4 A 6,6 0 0 1 11.9,9.6"/>
                                </Canvas>
                                <Canvas x:Name="VolumeMuted" Visibility="Collapsed">
                                    <Path Fill="#A6FFFFFF" Data="M 1,4 H 4 L 7.5,1 V 11 L 4,8 H 1 Z"/>
                                    <Path Stroke="#A6FFFFFF" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 9.6,4.2 L 13.4,8.2"/>
                                    <Path Stroke="#A6FFFFFF" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 13.4,4.2 L 9.6,8.2"/>
                                </Canvas>
                            </Grid>

                            <Slider x:Name="VolumeSlider" Grid.Column="1"
                                    Style="{StaticResource AppleSlider}"
                                    Minimum="0" Maximum="100" Value="60"
                                    ToolTip="系统音量"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 消息层：系统通知到达时自动展开，完整显示应用名 + 正文。
                     正文 TextWrapping=Wrap、不做截断；尺寸由代码按文本实测后设定。 -->
                <Grid x:Name="NotificationLayer"
                      Width="300" Height="96"
                      Opacity="0"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center">
                    <StackPanel Margin="16,12" VerticalAlignment="Center">
                        <TextBlock x:Name="MessageApp"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- 极端超长消息的兜底：内容超出可视高度时出现滚动条，绝不溢出胶囊 -->
                        <ScrollViewer x:Name="MessageScroll"
                                      Margin="0,4,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="MessageBody"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- SMTC 播放控制：独立一层，靠右对齐，随胶囊宽度自然跟随。
                     初始不可见：只有进入媒体态（有 SMTC 会话）后由 ApplyMorph 淡入，
                     否则会在待机胶囊里和时间/监控文字重叠。 -->
                <StackPanel x:Name="PlaybackControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Opacity="0"
                            IsHitTestVisible="False"
                            Margin="0,0,12,0">
                    <Button x:Name="PrevButton"
                            Style="{StaticResource CompactIconButton}"
                            ToolTip="上一首"
                            Click="OnSkipPrevious">
                        <Canvas Width="11" Height="9">
                            <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Data="M 5.2,0.8 L 1.4,4.5 L 5.2,8.2 Z"/>
                            <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Data="M 10.2,0.8 L 6.4,4.5 L 10.2,8.2 Z"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="PlayButton"
                            Style="{StaticResource CompactIconButton}"
                            ToolTip="播放 / 暂停"
                            Margin="3,0"
                            Click="OnTogglePlay">
                        <Grid Width="9" Height="9">
                            <!-- 不再依赖 Segoe UI Symbol / Emoji 字形：矢量图标在任意 DPI 下都完整清晰 -->
                            <Path x:Name="CompactPlayGlyph" Fill="{StaticResource IconPrimary}"
                                  Stroke="{StaticResource IconPrimary}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Data="M 1.6,0.8 L 7.6,4.5 L 1.6,8.2 Z"/>
                            <Grid x:Name="CompactPauseGlyph" Visibility="Collapsed">
                                <Rectangle Width="3" Height="9" RadiusX="1"
                                           Fill="{StaticResource IconPrimary}" HorizontalAlignment="Left"/>
                                <Rectangle Width="3" Height="9" RadiusX="1"
                                           Fill="{StaticResource IconPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton"
                            Style="{StaticResource CompactIconButton}"
                            ToolTip="下一首"
                            Click="OnSkipNext">
                        <Canvas Width="11" Height="9">
                            <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Data="M 1.4,0.8 L 5.2,4.5 L 1.4,8.2 Z"/>
                            <Path Fill="{StaticResource IconPrimary}" Stroke="{StaticResource IconPrimary}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Data="M 6.4,0.8 L 10.2,4.5 L 6.4,8.2 Z"/>
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
            </Canvas>

            <!-- 欢迎动画：在胶囊内部显示（被胶囊圆角裁剪），期间其它内容全部隐藏。
                 彩虹手写 "hello" 为纵向精灵图，运行时按帧切片逐帧播放。
                 这一层在 ContentHost 之外，因此自己用 IntroHelloScale 跟随全局缩放。 -->
            <Grid x:Name="IntroHello"
                  Width="65" Height="26"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="IntroHelloScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Image x:Name="IntroHelloImage"
                       Width="65" Height="26"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <!-- Siri 液态玻璃透镜：圆形折射玻璃 + 中心横向色散光带。
                 玻璃层由 LensGlowSurface 在运行时注入到 SiriOrb（必须是正方形，
                 着色器的椭圆 SDF 才能裁出正圆），文本与输入框放在圆下方，
                 胶囊自身的底色 / 高光在透镜展开时会整体淡出，不留任何方形框。 -->
            <Grid x:Name="SiriLensHost"
                  Width="260" Height="256"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,4,0,0"
                  Opacity="0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="SiriLensScale" ScaleX="0.6" ScaleY="0.6"/>
                </Grid.RenderTransform>

                <!-- 圆形玻璃球：正圆由着色器裁出，元素本身是正方形 -->
                <Grid x:Name="SiriOrb"
                      Width="124" Height="124"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,8,0,0"
                      IsHitTestVisible="False"/>

                <!-- 对话文本：放在透镜下方，低透明度淡色文字 -->
                <StackPanel x:Name="SiriTextLayer"
                            Margin="28,0,28,40"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                    <!-- 文字直接浮在桌面上，加一层柔和投影保证任何壁纸下都读得清 -->
                    <StackPanel.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
                    </StackPanel.Effect>
                    <TextBlock x:Name="SiriPromptText"
                               TextAlignment="Center"
                               FontSize="10"
                               Foreground="#B4FFFFFF"
                               TextWrapping="Wrap"
                               MaxHeight="14"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SiriReplyText"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               FontSize="10"
                               Foreground="#8CFFFFFF"
                               TextWrapping="Wrap"
                               MaxHeight="45"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SiriErrorText"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               FontSize="9.5"
                               Foreground="#E8FF7A6A"
                               TextWrapping="Wrap"
                               MaxHeight="22"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- 文字输入通道：与语音互为补充 -->
                <TextBox x:Name="SiriInputBox"
                         Margin="26,0,26,16"
                         Height="24"
                         VerticalAlignment="Bottom"
                         FontSize="10"
                         Foreground="#F0FFFFFF"
                         CaretBrush="#FFFFFFFF"
                         Background="#14FFFFFF"
                         BorderBrush="#26FFFFFF"
                         BorderThickness="1"
                         Padding="8,3,8,3"
                         Visibility="Collapsed"
                         KeyDown="OnSiriInputKeyDown">
                    <TextBox.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- 操作按钮：停止生成 / 清空对话 -->
                <StackPanel x:Name="SiriActions"
                            Margin="0,0,26,42"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button x:Name="SiriStopButton"
                            Style="{StaticResource CompactIconButton}"
                            ToolTip="停止生成"
                            Click="OnSiriStopClick">
                        <Canvas Width="9" Height="9">
                            <Rectangle Width="7" Height="7" RadiusX="1.5" Fill="#D8FFFFFF"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="SiriClearButton"
                            Style="{StaticResource CompactIconButton}"
                            ToolTip="清空对话"
                            Margin="2,0,0,0"
                            Click="OnSiriClearClick">
                        <Canvas Width="11" Height="9">
                            <Path Fill="#B4FFFFFF" Data="M 4.6,1 L 6.4,1 L 6.4,4.4 L 10,4.4 L 10,5.6 L 6.4,5.6
                                              L 6.4,8.6 L 4.6,8.6 L 4.6,5.6 L 1,5.6 L 1,4.4 L 4.6,4.4 Z"/>
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 工具面板：右键「工具面板」打开，独立弹层，不参与岛体形变与布局。
             上半是代码计时器，下半是剪贴板历史（点击条目写回剪贴板）。 -->
        <Popup x:Name="ToolsPopup"
               PlacementTarget="{Binding ElementName=CapsuleHost}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Opened="OnToolsPopupOpened"
               Closed="OnToolsPopupClosed">
            <Border Width="324"
                    CornerRadius="18"
                    Background="#F2171719"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    Padding="16,14,16,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270"
                                      Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- 代码计时器 -->
                    <StackPanel x:Name="ToolsTimerSection">
                        <TextBlock Text="代码计时器"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="CodeTimerText"
                                       Text="00:00.0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="14,6,0,0">
                                <Button x:Name="CodeTimerToggle"
                                        Width="58"
                                        Content="开始"
                                        Style="{StaticResource ToolsButton}"
                                        Click="OnCodeTimerToggle"/>
                                <Button Width="58"
                                        Content="重置"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ToolsButton}"
                                        Click="OnCodeTimerReset"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="ToolsDivider"
                            Height="1"
                            Background="{StaticResource DividerBrush}"
                            Margin="0,12,0,12"/>

                    <!-- 剪贴板历史 -->
                    <Grid x:Name="ToolsClipboardSection">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="剪贴板历史"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ClipboardClearButton"
                                    Content="清空"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ToolsLinkButton}"
                                    Click="OnClearClipboardHistory"/>
                        </Grid>

                        <TextBlock x:Name="ClipboardEmpty"
                                   Grid.Row="1"
                                   Text="还没有记录，复制点什么试试"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiary}"
                                   Margin="0,10,0,2"/>

                        <ScrollViewer x:Name="ClipboardScroll"
                                      Grid.Row="1"
                                      MaxHeight="190"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClipboardList"/>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock x:Name="ToolsDisabledHint"
                               Text="工具组件已全部关闭，可在 设置 → 通用 中开启"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
