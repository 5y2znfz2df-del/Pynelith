<Window x:Class="Pynelith.Island.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith Island"
        Width="260" Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9EFFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7BE0FF"/>

        <Style x:Key="CompactIconButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="7.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="IslandMenu">
            <MenuItem Header="设置" Click="OnOpenSettings"/>
            <MenuItem Header="退出 Pynelith" Click="OnExit"/>
        </ContextMenu>
    </Window.Resources>

    <!-- 窗口固定为最大形态尺寸（展开态）；真正的"岛"是 CapsuleHost，弹簧只改它的宽高。
         内容用「固定尺寸图层 + 交叉淡入」，动画帧内不做任何布局重算，因此不会有抖动。
         注意：IslandRoot 不能设 Background，否则整块隐形矩形会吞掉下方窗口的鼠标点击。 -->
    <Grid x:Name="IslandRoot" ClipToBounds="False">

        <Grid x:Name="CapsuleHost"
              Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="124" Height="24"
              ContextMenu="{StaticResource IslandMenu}"
              MouseLeftButtonDown="OnIslandMouseLeftButtonDown"
              MouseMove="OnIslandMouseMove"
              MouseLeftButtonUp="OnIslandMouseLeftButtonUp">

            <!-- 设计尺寸 = 胶囊尺寸（缩放前），ContentScale 统一放大 -->
            <Grid x:Name="ContentHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- 空闲态：无媒体播放时的时间胶囊 -->
                <Grid x:Name="IdleView" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleTime"
                                   Margin="7,0,0,0"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="9" Margin="8,0"
                                Background="{StaticResource DividerBrush}"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdleHint"
                                   Text="待机"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 紧凑态：200×24 固定图层（封面 + 单行歌词） -->
                <Grid x:Name="CompactLayer" Width="200" Height="24" Opacity="0">
                    <Border x:Name="CompactCover" Width="18" Height="18"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                            Background="#14FFFFFF">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,18,18" RadiusX="6" RadiusY="6"/>
                        </Border.Clip>
                        <Grid>
                            <Image x:Name="CompactCoverImage" Stretch="UniformToFill"/>
                            <Border x:Name="CompactCoverFallback">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#B44CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="♫" FontSize="8" Foreground="#E6FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="CompactLyricHost" Height="14" Margin="31,0,60,0"
                          VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock x:Name="CompactLyricA" FontSize="10.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactLyricATrans"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="CompactLyricB" FontSize="10.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactLyricBTrans"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- 展开态：260×60 固定图层（大封面 + 曲目信息 + 歌词） -->
                <Grid x:Name="DetailLayer" Width="260" Height="60" Opacity="0"
                      VerticalAlignment="Center">
                    <Border x:Name="DetailCover" Width="40" Height="40"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                            Background="#14FFFFFF">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,40,40" RadiusX="13" RadiusY="13"/>
                        </Border.Clip>
                        <Grid>
                            <Image x:Name="DetailCoverImage" Stretch="UniformToFill"/>
                            <Border x:Name="DetailCoverFallback">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#B44CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="♫" FontSize="15" Foreground="#E6FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="58,0,62,0">
                        <TextBlock x:Name="TrackLabel"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2"/>

                        <Grid x:Name="DetailLyricHost" Height="20" ClipToBounds="True">
                            <TextBlock x:Name="DetailLyricA" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="DetailLyricATrans"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="DetailLyricB" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="DetailLyricBTrans"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- SMTC 播放控制：独立一层，靠右对齐，随胶囊宽度自然跟随 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button x:Name="PrevButton"
                            Style="{StaticResource CompactIconButton}"
                            Content="⏮"
                            FontFamily="Segoe UI Symbol"
                            ToolTip="上一首"
                            Click="OnSkipPrevious"/>
                    <Button x:Name="PlayButton"
                            Style="{StaticResource CompactIconButton}"
                            Content="▶"
                            FontFamily="Segoe UI Symbol"
                            ToolTip="播放 / 暂停"
                            Margin="3,0"
                            Click="OnTogglePlay"/>
                    <Button x:Name="NextButton"
                            Style="{StaticResource CompactIconButton}"
                            Content="⏭"
                            FontFamily="Segoe UI Symbol"
                            ToolTip="下一首"
                            Click="OnSkipNext"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
