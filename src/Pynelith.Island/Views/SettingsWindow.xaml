<Window x:Class="Pynelith.Island.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith 设置"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#13161C"
        Foreground="#F0FFFFFF"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="#1CFFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="灵动岛设置" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="所有改动即时生效，并自动写入配置文件"
                   FontSize="10.5" Margin="0,5,0,0" Foreground="#70FFFFFF"/>
        <TextBlock x:Name="PathText"
                   FontSize="10" Margin="0,3,0,0"
                   Foreground="#59FFFFFF"
                   TextTrimming="CharacterEllipsis"/>

        <UniformGrid x:Name="SliderHost" Columns="2" Margin="0,16,0,0"/>

        <TextBlock Text="通知黑名单（每行一个应用名）"
                   FontSize="12" Margin="0,6,0,6" Foreground="#E6FFFFFF"/>
        <TextBox x:Name="BlacklistBox"
                 Height="66"
                 AcceptsReturn="True"
                 Background="#0FFFFFFF"
                 Foreground="#F0FFFFFF"
                 CaretBrush="#7BE0FF"
                 BorderBrush="#26FFFFFF"
                 Padding="8,6"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnBlacklistChanged"/>

        <CheckBox x:Name="LyricsCheck"
                  Content="显示歌词行"
                  FontSize="12.5"
                  Margin="0,14,0,0"
                  Foreground="#E6FFFFFF"
                  Checked="OnLyricsChanged"
                  Unchecked="OnLyricsChanged"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="恢复默认"
                    Style="{StaticResource FlatButton}"
                    HorizontalAlignment="Left"
                    Click="OnReset"/>

            <Button Grid.Column="1"
                    Content="完成"
                    Width="90"
                    Style="{StaticResource FlatButton}"
                    IsDefault="True"
                    Click="OnClose"/>
        </Grid>
    </StackPanel>
</Window>
