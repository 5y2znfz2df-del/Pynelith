<Window x:Class="Pynelith.Island.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith 设置"
        Width="800" Height="560"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E"
        Foreground="#FFFFFFFF"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SideBrush" Color="#232326"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#98989F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>

        <!-- iOS 风格开关 -->
        <Style x:Key="IosToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="42" Height="25"
                                CornerRadius="12.5"
                                Background="#39393D">
                            <Ellipse x:Name="Knob"
                                     Width="21" Height="21"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏条目 -->
        <Style x:Key="SideItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="8,6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步进按钮 -->
        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Foreground" Value="#BFFFFFFF"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="#3A3A3D" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0" Background="{StaticResource SideBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="12,14,12,10"
                        Background="#14FFFFFF" CornerRadius="8" Padding="8,5">
                    <TextBlock Text="搜索" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </Border>

                <ListBox x:Name="SideList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SideItem}"
                         SelectionChanged="OnSideChanged"/>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,18,26,6">
                <Border Width="46" Height="26" CornerRadius="13" Background="#2C2C2E">
                    <TextBlock Text="‹  ›" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="PageTitle" Text="通用"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       x:Name="ResetLink"
                       Text="恢复默认设置"
                       Foreground="#FF453A"
                       FontSize="12.5"
                       Cursor="Hand"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,18"
                       MouseLeftButtonUp="OnReset"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="26,10,26,0">
                <Grid x:Name="PageHost"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
