<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- 系统托盘常驻：NotifyIcon / ContextMenuStrip 来自 WinForms。
         app.manifest 里的 PerMonitorV2 同时服务 WPF，因此保留并关闭 WinForms 的重复提示。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 需要 WinRT 投影（UserNotificationListener 接管系统通知） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Pynelith.Island</RootNamespace>
    <AssemblyName>Pynelith.Island</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\pynelith.ico</ApplicationIcon>
    <!-- 单文件发布：WPF 原生库（wpfgfx / PresentationNative / D3DCompiler 等）必须一起进包，
         否则安装器只释放 exe 时会因缺少原生 DLL 在创建窗口时崩溃（DllNotFoundException）。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 压缩只在独立发布时受支持；框架依赖发布走默认（未压缩）单文件 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 开机自启要快：发布时预编译（ReadyToRun），把首次启动的 JIT 开销换成磁盘上的本机代码。
         只影响发布产物，日常 dotnet build 不受影响。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Description>灵动岛本体模块：时钟与 CPU/内存监控、悬浮动态岛、停靠定位、展开/收起动画、媒体与歌词、设置窗口与 JSON 配置（玻璃效果全部委托 Pynelith.Glass）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 渲染能力全部来自渲染模块的公开门面，本模块不引用任何渲染内部实现 -->
    <ProjectReference Include="..\Pynelith.Glass\Pynelith.Glass.csproj" />
    <!-- 插件契约（零依赖 netstandard2.0）：第三方插件只需引用这一个包 -->
    <ProjectReference Include="..\Pynelith.Plugins.Abstractions\Pynelith.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <!-- Siri 组件的第三方依赖：
       NAudio —— 麦克风采集（WASAPI / MMDevice 设备枚举、录音转 WAV）；
       Vosk —— 离线唤醒词识别（本地小模型，无需联网、无需 API 额度）。
       两者都只在用户启用 Siri 组件时才真正被加载。 -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- 系统离线语音：在线神经网络语音失败时兜底播报 -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- 字体：苹方 SC 子集（GB2312 + 拉丁，正文中黑 / 标题粗体）。
       作为 WPF 资源嵌入，pack URI 引用，用户无需额外安装。
       苹方是 Apple Inc. 的授权字体；分发授权由项目维护者提供，详见 README / LICENSE。 -->
  <ItemGroup>
    <Resource Include="Fonts\PingFangSC-Regular.ttf" />
    <Resource Include="Fonts\PingFangSC-Bold.ttf" />
  </ItemGroup>

  <!-- 开机 / 解锁欢迎动画素材：彩虹手写 "hello" 精灵图。
       纵向排列，每帧固定行高，运行时按行切帧逐帧播放。 -->
  <ItemGroup>
    <Resource Include="Assets\Intro\hello.png" />
  </ItemGroup>

  <!-- 托盘图标：与 exe 图标同一份 ICO，按托盘小图标尺寸（16/24/32）挑选帧 -->
  <ItemGroup>
    <Resource Include="..\..\assets\icon\pynelith.ico">
      <Link>Assets\pynelith.ico</Link>
    </Resource>
  </ItemGroup>

  <!-- 内置示例插件：仅参与构建排序（插件工程编译完会把 DLL + plugin.json 投放到 Plugins\）。
       不引用其程序集——插件与宿主只通过 Pynelith.Plugins.Abstractions 契约通信。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.Weather\Pynelith.Plugin.Weather.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.GespCountdown\Pynelith.Plugin.GespCountdown.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.DdcBrightness\Pynelith.Plugin.DdcBrightness.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.BluetoothBattery\Pynelith.Plugin.BluetoothBattery.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.JianyingShortcut\Pynelith.Plugin.JianyingShortcut.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Pynelith.Plugin.McpBridge\Pynelith.Plugin.McpBridge.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 把 Plugins\ 整棵目录同步到 bin 与 publish 输出。
       放在 Target 内求值（而不是顶层 ItemGroup），才能拿到本轮刚编译出来的插件文件。 -->
  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <ItemGroup>
      <BundledPluginFile Include="$(MSBuildProjectDirectory)\Plugins\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledPluginFile)"
          DestinationFiles="@(BundledPluginFile->'$(OutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <BundledPluginFilePublish Include="$(MSBuildProjectDirectory)\Plugins\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledPluginFilePublish)"
          DestinationFiles="@(BundledPluginFilePublish->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
