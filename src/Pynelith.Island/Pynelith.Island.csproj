<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- 需要 WinRT 投影（UserNotificationListener 接管系统通知） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Pynelith.Island</RootNamespace>
    <AssemblyName>Pynelith.Island</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\pynelith.ico</ApplicationIcon>
    <!-- 单文件发布：WPF 原生库（wpfgfx / PresentationNative / D3DCompiler 等）必须一起进包，
         否则安装器只释放 exe 时会因缺少原生 DLL 在创建窗口时崩溃（DllNotFoundException）。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 压缩只在独立发布时受支持；框架依赖发布走默认（未压缩）单文件 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Description>灵动岛本体模块：时钟与 CPU/内存监控、悬浮动态岛、停靠定位、展开/收起动画、媒体与歌词、设置窗口与 JSON 配置（玻璃效果全部委托 Pynelith.Glass）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 渲染能力全部来自渲染模块的公开门面，本模块不引用任何渲染内部实现 -->
    <ProjectReference Include="..\Pynelith.Glass\Pynelith.Glass.csproj" />
  </ItemGroup>

  <!-- 字体：不内置第三方字体。XAML 使用系统字体栈
       PingFang SC → Microsoft YaHei UI → Segoe UI，仓库与安装包都不再携带苹方文件。 -->

</Project>
