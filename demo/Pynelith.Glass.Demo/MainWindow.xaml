<Window x:Class="Pynelith.Glass.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pynelith Glass Demo"
        Height="132"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Background="#33FFFFFF"
                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 整个窗口内容由液态玻璃着色器绘制（含圆角与亮边），
         因此这里不需要实色背景；层窗口让圆角外的桌面真正透出。 -->
    <Grid x:Name="Island"
          Margin="14"
          Background="Transparent"
          MouseLeftButtonDown="OnIslandDrag">

        <Grid Margin="24,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Pynelith · Liquid Glass"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#F5FFFFFF"/>
                <TextBlock x:Name="StatusText"
                           FontSize="11" Margin="0,3,0,0"
                           Foreground="#B3FFFFFF"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Clear" Tag="Clear" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Frosted" Tag="Frosted" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Tinted" Tag="Tinted" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Acrylic" Tag="Acrylic" Click="OnKindClick" Style="{StaticResource PillButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
