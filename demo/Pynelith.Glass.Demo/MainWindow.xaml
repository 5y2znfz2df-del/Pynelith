<Window x:Class="Pynelith.Glass.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pynelith Glass Demo"
        Width="640" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="#39FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- GlassFrameThickness=-1：把 DWM 帧扩展到整个客户区，
         透明内容区域即可透出系统背景（Mica/Acrylic）或伴随模糊窗口 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1" CornerRadius="0" CaptionHeight="40" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Island"
            Margin="6"
            CornerRadius="20"
            Background="#3018181C">
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="Pynelith · Liquid Glass"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="#F0FFFFFF"/>
                <TextBlock x:Name="StatusText"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="#B0FFFFFF"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="Auto" Tag="Auto" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Mica" Tag="Mica" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Acrylic" Tag="Acrylic" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="HostBlur" Tag="HostBlur" Click="OnKindClick" Style="{StaticResource PillButton}"/>
                <Button Content="Legacy" Tag="Legacy" Click="OnKindClick" Style="{StaticResource PillButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
